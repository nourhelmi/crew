#!/bin/sh
# Resolve the repo through symlinks (~/.local/bin/crew -> repo/bin/crew).
self=$(readlink -f "$0" 2>/dev/null || realpath "$0")
root=$(cd "$(dirname "$self")/.." && pwd)

# Plugin caches hold a snapshot; the installed checkout is the one live copy.
live=$(readlink -f "$HOME/.local/bin/crew" 2>/dev/null)
if [ -n "$live" ] && [ "$live" != "$self" ] && [ -x "$live" ] && [ -z "${CREW_NO_DELEGATE:-}" ]; then
  CREW_NO_DELEGATE=1 exec "$live" "$@"
fi

# Hooks run from GUI-launched hosts where nvm's node may be missing from PATH.
node_bin=${CREW_NODE:-$(command -v node 2>/dev/null)}
if ! "$node_bin" -e 'process.exit(Number(Number(process.versions.node.split(".")[0]) < 24))' >/dev/null 2>&1; then
  node_bin=$(ls -d "$HOME"/.nvm/versions/node/v2[4-9]*/bin/node 2>/dev/null | sort -V | tail -1)
fi
[ -x "$node_bin" ] || { echo "crew: node >= 24 not found" >&2; exit 127; }

exec "$node_bin" --disable-warning=ExperimentalWarning "$root/src/cli.ts" "$@"
